<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter_BS.Views.NewPage1"
             Title="New counter">
    <VerticalStackLayout Spacing="10" Margin="5">

        <Editor x:Name="AddCounterName"
                Text="{Binding CounterName}"
                Placeholder="{Binding EditorPlaceholderText}"
                HeightRequest="100" />
        
        <Entry x:Name="InitialValueEntry"
                Keyboard="Numeric"
                Placeholder="set custom value" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
            <Button Text="{Binding SaveButtonText}"
                    Grid.Column="0"
                    Clicked="SaveButtonClicked" />
            <Button Text="{Binding CancelButtonText}"
                    Grid.Column="1"
                    Clicked="CancelButtonClicked" />
        </Grid>

    </VerticalStackLayout>
</ContentPage>