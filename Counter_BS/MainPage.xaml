<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter_BS.MainPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding AddCounterButton}"
                     Clicked="AddCounterClicked" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Counters}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <HorizontalStackLayout Spacing="15" Padding="10" HorizontalOptions="Center" >
                    <Label Text="{Binding CounterName}" VerticalOptions="Center" />
                    <Button Text="-" Clicked="OnMinusClicked" />
                    <Label Text="{Binding Value}" VerticalOptions="Center" />
                    <Button Text="+" Clicked="OnPlusClicked" />
                    <Button Text="❌" Clicked="OnDeleteClicked" TextColor="Tomato" FontSize="22" Padding="5,0" BackgroundColor="Transparent" />
                </HorizontalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>